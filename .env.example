# Copy to .env and fill in. Never commit .env. Generate secrets with:  openssl rand -base64 48
AEGIS_DOMAIN=aegistrace.example.com        # public DNS name; Caddy obtains a TLS certificate for it automatically
POSTGRES_PASSWORD=change-me

# Secrets (all required in production; the server refuses to start without them)
AEGIS_SESSION_KEY=            # signs session tokens
AEGIS_AUDIT_KEY=              # HMAC key of the audit chain; keep it OUT of the database host
AEGIS_DATA_KEY=               # encrypts TOTP seeds at rest

# Service accounts that ingest events: JSON array of {key,userId,orgId,role}. Keep keys long and random.
AEGIS_API_KEYS=[{"key":"REPLACE-WITH-LONG-RANDOM","userId":"svc-collector","orgId":"org-main","role":"ingestor"}]

# First admin (people log in with password [+ MFA]). Generate the entry with:
#   cd api && npm run user-tool -- '<password>'      -> prints {"passwordHash":"scrypt:..."}; paste it below
AEGIS_USERS=[{"userId":"admin","orgId":"org-main","role":"admin","passwordHash":"scrypt:REPLACE"}]

# Optional
AEGIS_RETENTION_DAYS=90                    # events; closed incidents are kept 3x as long unless AEGIS_INCIDENT_RETENTION_DAYS is set
AEGIS_SERVICE_ACCOUNTS=svc-*,ci-*,*-bot    # accounts whose failed logins are expected (rule severity lowered)
AEGIS_CHANGE_APPROVERS=                    # people allowed to grant admin roles without raising an alert
# AEGIS_ANALYSIS_PROVIDER=openai           # or anthropic; also OPENAI_API_KEY / ANTHROPIC_API_KEY and AEGIS_LLM_MODEL
# OIDC_ISSUER= OIDC_CLIENT_ID= OIDC_CLIENT_SECRET= OIDC_REDIRECT_URI=https://$AEGIS_DOMAIN/api/v1/auth/oidc/callback OIDC_ORG_ID=org-main OIDC_ROLE_MAP={"sec-admins":"admin"}
